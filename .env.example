# Cloudflare R2 (optional — omit for local filesystem storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sandook-media
R2_PUBLIC_URL=

# Auth (change these for local dev — production deploy rejects defaults)
ADMIN_PASSWORD=dev
SESSION_SECRET=dev-session-secret-min-32-chars!!

# Site URL (production)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Set on Vercel production to require strong ADMIN_PASSWORD + SESSION_SECRET
# SANDOOK_ENFORCE_SECRETS=true

# WhatsApp (international format, no + — e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Inquiry notifications (inquiries always saved to storage/inquiries.json)
# Gmail SMTP is tried first; Resend is used only if SMTP is not configured.
INQUIRY_EMAIL=you@gmail.com
CONTACT_EMAIL=

# Gmail SMTP (recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Sandook Studio <you@gmail.com>

# Resend (optional fallback if SMTP is not set)
RESEND_API_KEY=
RESEND_FROM="Sandook Studio <onboarding@resend.dev>"
