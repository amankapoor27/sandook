# Cloudflare R2 (optional — omit for local filesystem storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sandook-media
R2_PUBLIC_URL=

# Auth (defaults shown work for local dev)
ADMIN_PASSWORD=dev
SESSION_SECRET=dev-session-secret-min-32-chars!!

# Site URL (production)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# WhatsApp (international format, no + — e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Inquiry notifications (optional — inquiries always saved to storage)
RESEND_API_KEY=
INQUIRY_EMAIL=
CONTACT_EMAIL=
